{
  "name": "Linux Extras (from VRCOSC)",
  "id": "vrcosc_modules",
  "version": "2.0.0",
  "author": "Bluscream & yakuda",
  "description": "Extras for Linux from Bluscream's VRCOSC module set - only what the app and the other plugins do not already do. System: RAM and VRAM in GB, network speed, totals and peaks, the active window and the VR mode. Player status: play/pause icon and volume. Programs: which of your programs are running. OpenXR: runtime, session and VR uptime. VRCX: friends online and friend events. VRChat settings: values from VRChat's config.json. Home Assistant, HTTP, IRC, a small server for other programs, and notifications. Every block is off until you switch it on and costs nothing while it is off. CPU, GPU, temperatures and the song title are in the app itself, FPS in World Stats. Based on github.com/Bluscream/VRCOSC-Modules (GPL-3.0).",
  "Github": "github.com/Bluscream/VRCOSC-Modules",
  "main": "main.py",
  "image": "logo.png",
  "enabled": true,
  "is_linux": true,
  "is_windows": false,
  "template": "{hw_ram} {hw_net} \\n {xr_vr} {vx_friends}",
  "placeholders": {
    "hw_ram": "RAM block - icon plus used/total",
    "hw_ram_usage": "RAM load in percent",
    "hw_ram_used": "RAM in use, in GB",
    "hw_ram_total": "RAM installed, in GB",
    "hw_vram": "VRAM block - icon plus used/total",
    "hw_vram_usage": "VRAM load in percent",
    "hw_vram_used": "VRAM in use, in GB",
    "hw_vram_total": "VRAM on the card, in GB",
    "hw_net": "network block - down and up",
    "hw_net_rx": "download speed",
    "hw_net_tx": "upload speed",
    "hw_vr_mode": "Desktop / SteamVR / OpenXR",
    "hw_window": "title of the active window",
    "hw_process": "process behind the active window",
    "hw_vrchat": "shown only while VRChat is running",
    "net_max_down": "fastest download this session",
    "net_max_up": "fastest upload this session",
    "net_total_down": "downloaded (since app start or boot)",
    "net_total_up": "uploaded (since app start or boot)",
    "net_utilization": "how much of the link speed is in use",
    "md_status": "Playing / Paused / Stopped",
    "md_volume": "player volume",
    "pm_list": "watched programs that are running",
    "pm_missing": "watched programs that are not",
    "pm_count": "how many of them are running",
    "pm_state": "running / watched, e.g. 2/3",
    "pm_total": "processes on the machine",
    "xr_vr": "VR block - icon, mode, uptime",
    "xr_runtime": "OpenXR runtime in use",
    "xr_mode": "SteamVR / Monado / WiVRn / Desktop",
    "xr_session": "text while a headset session runs",
    "xr_uptime": "how long you have been in VR",
    "vx_world": "world VRCX last logged",
    "vx_friends": "friends currently online",
    "vx_last_friend": "who triggered the last friend event",
    "vx_last_event": "Online / Offline",
    "vx_status": "icon while the database is readable",
    "vc_1": "VRChat config value 1",
    "vc_2": "VRChat config value 2",
    "vc_all": "both values in one string",
    "vc_status": "icon while config.json was found",
    "ha_1": "Home Assistant entity 1",
    "ha_2": "Home Assistant entity 2",
    "ha_3": "Home Assistant entity 3",
    "ha_all": "all three entities in one string",
    "ha_count": "how many entities answered",
    "ha_online": "icon while the server answers",
    "ht_text": "the answer of the HTTP request",
    "ht_status": "HTTP status code",
    "ht_count": "requests sent since the start",
    "ht_ok": "icon for success or failure",
    "irc_msg": "newest message in the channel",
    "irc_author": "who wrote it",
    "irc_channel": "the channel",
    "irc_count": "messages seen since the start",
    "irc_online": "icon while connected",
    "sv_text": "text somebody pushed into the server",
    "sv_requests": "requests the server answered",
    "sv_status": "icon plus port",
    "sv_port": "port the server listens on",
    "nt_last": "text of the last notification",
    "nt_count": "notifications sent"
  },
  "global_placeholders": [
    "hw_ram",
    "hw_ram_usage",
    "hw_ram_used",
    "hw_ram_total",
    "hw_vram",
    "hw_vram_usage",
    "hw_vram_used",
    "hw_vram_total",
    "hw_net",
    "hw_net_rx",
    "hw_net_tx",
    "hw_vr_mode",
    "hw_window",
    "hw_process",
    "hw_vrchat",
    "net_max_down",
    "net_max_up",
    "net_total_down",
    "net_total_up",
    "net_utilization",
    "md_status",
    "md_volume",
    "pm_list",
    "pm_missing",
    "pm_count",
    "pm_state",
    "pm_total",
    "xr_vr",
    "xr_runtime",
    "xr_mode",
    "xr_session",
    "xr_uptime",
    "vx_world",
    "vx_friends",
    "vx_last_friend",
    "vx_last_event",
    "vx_status",
    "vc_1",
    "vc_2",
    "vc_all",
    "vc_status",
    "ha_1",
    "ha_2",
    "ha_3",
    "ha_all",
    "ha_count",
    "ha_online",
    "ht_text",
    "ht_status",
    "ht_count",
    "ht_ok",
    "irc_msg",
    "irc_author",
    "irc_channel",
    "irc_count",
    "irc_online",
    "sv_text",
    "sv_requests",
    "sv_status",
    "sv_port",
    "nt_last",
    "nt_count"
  ],
  "user_reorderable": true,
  "settings": [
    {
      "key": "g_hw",
      "type": "group",
      "label": "🖥️ System  –  RAM/VRAM in GB, network, active window, VR mode",
      "expanded": false,
      "hint": "What the app's own Hardware card does not show. CPU, GPU and temperatures: use the app's Hardware card; FPS: World Stats.",
      "items": [
        {
          "key": "hw_enable",
          "type": "bool",
          "label": "Enable",
          "default": true,
          "hint": "Nothing runs while this is off - no thread, no request, no script"
        },
        {
          "key": "hw_show_ram",
          "type": "bool",
          "label": "RAM  –  {hw_ram}",
          "default": true,
          "depends": "hw_enable"
        },
        {
          "key": "hw_show_vram",
          "type": "bool",
          "label": "VRAM  –  {hw_vram}",
          "default": false,
          "depends": "hw_enable"
        },
        {
          "key": "hw_show_net",
          "type": "bool",
          "label": "Network  –  {hw_net}",
          "default": false,
          "depends": "hw_enable"
        },
        {
          "key": "hw_net_total_since",
          "type": "choice",
          "label": "Totals count since",
          "default": "app",
          "depends": "hw_show_net",
          "hint": "Also {net_max_down} {net_max_up} (peaks this session), {net_total_down} {net_total_up} and {net_utilization} (of the link speed, wired only).",
          "choices": [
            {
              "value": "app",
              "label": "The app started"
            },
            {
              "value": "boot",
              "label": "The PC started"
            }
          ]
        },
        {
          "key": "hw_show_vr",
          "type": "bool",
          "label": "VR mode  –  {hw_vr_mode}",
          "default": false,
          "depends": "hw_enable",
          "hint": "Desktop, SteamVR or OpenXR"
        },
        {
          "key": "hw_show_win",
          "type": "bool",
          "label": "Active window  –  {hw_window}",
          "default": false,
          "depends": "hw_enable",
          "hint": "Needs xdotool (X11/XWayland) or kdotool (KDE Wayland)"
        },
        {
          "key": "hw_show_vrc",
          "type": "bool",
          "label": "VRChat running  –  {hw_vrchat}",
          "default": false,
          "depends": "hw_enable"
        },
        {
          "key": "hw_mem_style",
          "type": "choice",
          "label": "RAM and VRAM as",
          "default": "used_total",
          "choices": [
            {
              "value": "used_total",
              "label": "Used / total  –  14.2/32.0 GB"
            },
            {
              "value": "used",
              "label": "Used only  –  14.2 GB"
            },
            {
              "value": "percent",
              "label": "Percent  –  44%"
            }
          ],
          "depends": "hw_enable"
        },
        {
          "key": "hw_icon_ram",
          "type": "text",
          "label": "RAM icon",
          "default": "💾",
          "depends": "hw_show_ram"
        },
        {
          "key": "hw_icon_vram",
          "type": "text",
          "label": "VRAM icon",
          "default": "📊",
          "depends": "hw_show_vram"
        },
        {
          "key": "hw_gpu_index",
          "type": "int",
          "label": "Graphics card for VRAM",
          "default": 0,
          "min": 0,
          "max": 7,
          "depends": "hw_show_vram",
          "hint": "0-based - the amdgpu hwmon order, or the nvidia-smi index"
        },
        {
          "key": "hw_icon_vr",
          "type": "text",
          "label": "VR icon",
          "default": "🥽",
          "depends": "hw_show_vr",
          "hint": "Only shown when a compositor is up, not on Desktop"
        },
        {
          "key": "hw_vrc_text",
          "type": "text",
          "label": "VRChat text",
          "default": "VRChat",
          "depends": "hw_show_vrc"
        },
        {
          "key": "hw_win_max",
          "type": "slider",
          "label": "Window title length",
          "default": 24,
          "min": 6,
          "max": 64,
          "depends": "hw_show_win",
          "suffix": " chars"
        },
        {
          "key": "hw_iface",
          "type": "text",
          "label": "Network interface",
          "default": "",
          "depends": "hw_show_net",
          "hint": "e.g. enp5s0 - empty adds up every interface except lo"
        },
        {
          "key": "hw_interval",
          "type": "slider",
          "label": "Refresh interval",
          "default": 3,
          "min": 1,
          "max": 30,
          "depends": "hw_enable",
          "hint": "One run of the script samples for about 0.25 s",
          "suffix": " s"
        },
        {
          "key": "hw_script",
          "type": "text",
          "label": "Own vrcosc_hwstats.sh",
          "default": "",
          "depends": "hw_enable",
          "hint": "Advanced: path to your own copy, empty uses the bundled one"
        }
      ]
    },
    {
      "key": "g_md",
      "type": "group",
      "label": "🎵 Player status  –  ▶/⏸ and volume",
      "hint": "The two values MediaPlay does not have. Title, artist, time and songbar: use the app's MediaPlay card.",
      "items": [
