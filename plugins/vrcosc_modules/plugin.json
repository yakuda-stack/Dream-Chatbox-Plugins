        },
        {
          "key": "pm_sep",
          "type": "text",
          "label": "Separator",
          "default": " ",
          "depends": "pm_enable"
        },
        {
          "key": "pm_interval",
          "type": "slider",
          "label": "Refresh interval",
          "default": 5,
          "min": 1,
          "max": 120,
          "depends": "pm_enable",
          "suffix": " s"
        }
      ],
      "expanded": false
    },
    {
      "key": "g_xr",
      "type": "group",
      "label": "🥽 OpenXR  –  runtime, session, VR uptime",
      "hint": "Runtime, session and VR uptime. Gesture and haptic control are not portable - see the README.",
      "items": [
