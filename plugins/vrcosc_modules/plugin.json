          "default": true,
          "depends": "md_enable"
        },
        {
          "key": "md_interval",
          "type": "slider",
          "label": "Refresh interval",
          "default": 3,
          "min": 1,
          "max": 60,
          "depends": "md_enable",
          "suffix": " s"
        },
        {
          "key": "md_script",
          "type": "text",
          "label": "Own vrcosc_mpris_query.sh",
          "default": "",
          "depends": "md_enable",
          "hint": "Advanced: path to your own copy, empty uses the bundled one"
        }
